<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="NotasRapidasSQLite.Views.NotasPage"
    Title="Mis notas">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label
            Text="Mis notas"
            FontSize="28"
            FontAttributes="Bold"
            TextColor="#263238" />

        <SearchBar
            Placeholder="Buscar nota por título..."
            Text="{Binding TextoBusqueda}"
            />

        <Button
            Text="+ Nueva nota"
            Command="{Binding NuevaNotaCommand}"
            BackgroundColor="#1976D2"
            TextColor="White"
            CornerRadius="10" />

        <CollectionView
            ItemsSource="{Binding Notas}"
            SelectionMode="None">

            <CollectionView.EmptyView>
                <Label
                    Text="No hay notas todavía."
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    TextColor="Gray" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame
                        Padding="15"
                        Margin="0,5"
                        CornerRadius="10"
                        BorderColor="#DDDDDD"
                        HasShadow="False">

                        <Grid ColumnDefinitions="*,Auto">

                            <VerticalStackLayout Grid.Column="0">
                                <Label
                                    Text="{Binding Titulo}"
                                    FontSize="18"
                                    FontAttributes="Bold" />

                                <Label
                                    Text="{Binding FechaModificacion, StringFormat='Modificada: {0:dd/MM/yyyy HH:mm}'}"
                                    FontSize="12"
                                    TextColor="Gray" />
                            </VerticalStackLayout>

                            <Button
                                Grid.Column="1"
                                Text="Abrir"
                                CommandParameter="{Binding Id}"
                                Clicked="AbrirNota_Clicked"
                                VerticalOptions="Center" />

                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </VerticalStackLayout>
</ContentPage>
